{
  "model": "fable[1m]",
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dcg"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts",
    "padding": 0
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "includeCoAuthoredBy": false,
  "respectGitignore": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
