{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildkite": {
      "type": "local",
      "enabled": false,
      "command": ["buildkite-mcp-server", "stdio"],
      "environment": {
        "BUILDKITE_API_TOKEN": "{env:BUILDKITE_API_TOKEN}",
        "BUILDKITE_ORG_SLUG": "ahrefs",
      },
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "chrome-devtools-mcp@1.2.0",
        "--browser-url=http://127.0.0.1:9222",
      ],
    },
    "grafana": {
      "type": "local",
      "enabled": true,
      "command": ["grafana-mcp"],
    },
    "playwriter": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "playwriter@latest"],
      "environment": {
        "PLAYWRITER_HOST": "http://127.0.0.1:19989",
      },
    },
  },
}
