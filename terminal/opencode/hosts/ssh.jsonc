{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildkite": {
      "type": "local",
      "enabled": false,
      "command": ["buildkite-mcp-server", "stdio"],
      "environment": {
        "BUILDKITE_API_TOKEN": "{env:BUILDKITE_API_TOKEN}",
        "BUILDKITE_ORG_SLUG": "ahrefs",
      },
    },
    "grafana": {
      "type": "local",
      "enabled": true,
      "command": ["grafana-mcp"],
    },
  },
}
