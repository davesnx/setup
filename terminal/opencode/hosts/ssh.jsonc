{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp",
      "oauth": {
        "callbackPort": 25121
      }
    },
    "ahrefs": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.ahrefs.com/mcp/mcp",
      "oauth": {
        "callbackPort": 25122
      }
    },
    "linear": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.linear.app/mcp",
      "oauth": {
        "callbackPort": 25123
      }
    },
    "strava": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@r-huijts/strava-mcp-server"
      ]
    },
    "grafana": {
      "type": "local",
      "enabled": true,
      "command": [
        "grafana-mcp"
      ]
    },
    "buildkite": {
      "type": "local",
      "enabled": true,
      "command": [
        "buildkite-mcp-server",
        "stdio"
      ],
      "environment": {
        "BUILDKITE_API_TOKEN": "{env:BUILDKITE_API_TOKEN}",
        "BUILDKITE_ORG_SLUG": "ahrefs"
      }
    }
  }
}
