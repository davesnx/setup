{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp"
    },
    "ahrefs": {
      "type": "remote",
      "enabled": false,
      "url": "https://api.ahrefs.com/mcp/mcp"
    },
    "linear": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.linear.app/mcp"
    },
    "strava": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@r-huijts/strava-mcp-server"
      ]
    }
  }
}
