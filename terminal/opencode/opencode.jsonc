{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": "notify",
  "snapshot": true,
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-5.4-nano",
  "agent": {
    "general": {
      "model": "openai/gpt-6-astra",
    },
  },
  "instructions": ["pstack-models.md"],
  "experimental": {
    "disable_paste_summary": true,
  },
  "watcher": {
    "ignore": [".opencode/**"],
  },
  "plugin": [
    "opencode-goal-plugin@0.9.0",
    "cursor-oauth-opencode@0.22.1",
    "./plugins/opencode-notify/src/notify.ts",
    "@plannotator/opencode@latest",
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:OPENCODE_ANTHROPIC_API_KEY}",
      },
    },
    // Cursor proprietary models bridged via the cursor-oauth-opencode plugin
    "cursor": {
      "name": "Cursor",
      "npm": "@ai-sdk/openai-compatible",
      "api": "http://127.0.0.1:65535/v1",
      "models": {
        "composer-2.5-fast": {
          "name": "Composer 2.5 Fast",
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "tool_call": true,
          "limit": { "context": 200000, "input": 200000, "output": 64000 },
        },
        "composer-2.5": {
          "name": "Composer 2.5",
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "tool_call": true,
          "limit": { "context": 200000, "input": 200000, "output": 64000 },
        },
        "grok-4.6": {
          "name": "Grok 4.6",
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "tool_call": true,
          "limit": { "context": 256000, "input": 256000, "output": 64000 },
        },
        "grok-4.6-fast": {
          "name": "Grok 4.6 Fast",
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "tool_call": true,
          "limit": { "context": 256000, "input": 256000, "output": 64000 },
        },
      },
    },
  },
  "command": {
    "research": {
      "description": "Run web research with citations",
      "agent": "general",
      "subtask": true,
      "template": "$ARGUMENTS\n\nRequirements:\n- Start with 4-8 focused search queries.\n- Use websearch for discovery and webfetch for source verification.\n- Prefer primary and official sources.\n- Cross-check claims across independent sources.\n- Return output with sections: Objective, Findings, Conflicts/Uncertainty, Sources, Next questions.\n- In Sources include title + URL and a one-line relevance note.\n- If evidence is weak, say so explicitly.",
    },
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build",
    },
    "variate": {
      "description": "Create and compare visual design variations",
      "template": "Load the `variate` skill and follow it for this request: $ARGUMENTS",
      "agent": "build",
    },
    "autoresearch": {
      "description": "Run a bounded, measured experiment loop for an optimization target",
      "template": "Load the `autoresearch` skill and follow it for this request: $ARGUMENTS",
      "agent": "build",
    },
  },
  // Posture: allow by default, deny the genuinely destructive
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "allow",
      "/tmp/**": "allow",
      // "$HOME" is not expanded by opencode; "~/" is. "~/**" does not match bare "~", so list both.
      "~": "allow",
      "~/**": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
    },
    // Path-matched, so these hold even when cwd is $HOME and the external_directory rules above never fire. Re-states the built-in .env defaults, which defining "read" would otherwise replace.
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
    },
    "bash": {
      "*": "allow",
      // Patterns are matched against each PARSED command, not the raw command
      // line: opencode splits on "|" and "&&" and tests every segment
      // separately. Verified empirically -- "echo ok && sudo --version" is
      // caught by the unanchored "sudo *" rule below.
      //
      // Consequently these patterns are anchored at the start. A leading "*"
      // is not needed to catch a command mid-pipeline, and adding one causes
      // false positives: it makes the rule fire on any command that merely
      // MENTIONS the string in a quoted argument or heredoc, e.g.
      //   gh pr comment -b "never use git push --force"
      // Path patterns (.ssh/id_* below) are the exception -- they match an
      // argument rather than the command name, so they keep their wildcard.
      //
      // Destructive filesystem operations.
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "shred *": "deny",
      "dd if=*": "deny",
      "mkfs*": "deny",
      // This also catches --force-with-lease and --force-if-includes
      "git *--force*": "deny",
      // The -f shorthand, enumerated per subcommand. A blanket "git *-f*" cannot be used: it would also match --format, --follow, --file.
      "git push -f*": "deny",
      "git clean -f*": "deny",
      "git checkout -f*": "deny",
      "git switch -f*": "deny",
      "git branch -f*": "deny",
      // Hook bypass: --no-verify covers commit and push, and the -c core.hooksPath route skips hooks without naming --no-verify.
      "git *--no-verify*": "deny",
      "git *commit *-n*": "deny",
      "git *core.hooksPath*": "deny",
      // History rewriting.
      "git reset --hard*": "deny",
      "git filter-branch*": "deny",
      // Ask on curl ... | sh
      "sh": "ask",
      "bash": "ask",
      "zsh": "ask",
      "sh -s*": "ask",
      "bash -s*": "ask",
      // Privilege escalation and host control
      "sudo *": "deny",
      "su *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      // Secret exfiltration via shell, which "read" rules cannot see
      "*.ssh/id_*": "deny",
      "*.aws/credentials*": "deny",
    },
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 30000,
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20,
  },
  "mcp": {
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp",
    },
    "ahrefs": {
      "type": "remote",
      "enabled": false,
      "url": "https://api.ahrefs.me/mcp/mcp",
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking",
      ],
    },
    "linear": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.linear.app/mcp",
      "oauth": {
        "callbackPort": 25123,
      },
    },
  },
}
