#!/usr/bin/env bash

root=$(CDPATH='' cd "$(dirname "$0")/../.." && pwd)
harness_root="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/node_modules/@nano-step/eval-harness/scripts/eval"
command_name="${1:-run}"

if [[ ! -d "$harness_root" ]]; then
	printf 'eval-harness is not installed. Run ./terminal/opencode/install.sh first.\n' >&2
	exit 1
fi

opencode_bin="$(command -v opencode)" || exit 1

case "$command_name" in
	run|baseline|accept|status|trend|promote)
		[[ $# -eq 0 ]] || shift
		;;
	*)
		printf 'usage: eval-harness {run|baseline|accept|status|trend|promote} [options]\n' >&2
		exit 2
		;;
esac

OPENCODE_SKILLS_ROOT="$root/skills" \
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-${OPENCODE_ANTHROPIC_API_KEY:-}}" \
EVAL_SMOKE_MODEL="${EVAL_SMOKE_MODEL:-anthropic/claude-haiku-4-5}" \
EVAL_FULL_MODEL="${EVAL_FULL_MODEL:-anthropic/claude-sonnet-4-6}" \
EVAL_PRICING_FILE="$root/terminal/opencode/eval-harness-pricing.json" \
OPENCODE_REAL_BIN="$opencode_bin" \
PATH="$root/terminal/opencode/eval-bin:$PATH" \
bash "$harness_root/$command_name.sh" "$command_name" "$@"
