# Sets sane Zsh built-in environment options
zmodule environment

# Applies correct bindkeys for input events
zmodule input

# Shift selection in the command line, using its own temporary keymap.
zmodule jirutka/zsh-shift-select

# Sets a custom terminal title
zmodule termtitle

# Utility aliases and functions. Adds colour to ls, grep and less
# zmodule utility

# Exposes git repository status information to prompts, used by davesnx theme
zmodule git-info

# Additional completion definitions for Zsh. Must be sourced before the completion module.
zmodule zsh-users/zsh-completions --fpath src
# Enables and configures smart and extensive tab completion. Must be sourced after all modules that add completion definitions.
if [[ -n "$HOMEBREW_PREFIX" && -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]]; then
    zmodule "$HOMEBREW_PREFIX/share/zsh/site-functions" --fpath .
fi
# Only the zimfw completion function. terminal/zsh/completion.zsh replaces the
# module init, which stats every completion file on each start.
zmodule completion --fpath functions

# Fish-like autosuggestions for Zsh. -d keeps the clone installed and updated by
# zimfw without sourcing it; .zshrc sources it through zsh-defer for faster startup.
zmodule zsh-users/zsh-autosuggestions -d

# Fish-like history search (up arrow) for Zsh. -d installs it without sourcing;
# .zshrc sources it through zsh-defer after zsh-syntax-highlighting.
zmodule zsh-users/zsh-history-substring-search -d

# Fish-like syntax highlighting for Zsh. -d installs it without sourcing;
# .zshrc sources it through zsh-defer after completion.
zmodule zsh-users/zsh-syntax-highlighting -d

# Defer loading of modules until after compinit
zmodule romkatv/zsh-defer -d
