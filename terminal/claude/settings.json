{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "USE_BUILTIN_RIPGREP": "1",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "BASH_MAX_OUTPUT_LENGTH": "60000",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree list:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(opam exec:*)",
      "Bash(opam list:*)",
      "Bash(opam show:*)",
      "Bash(opam switch list:*)",
      "Bash(dune build:*)",
      "Bash(dune test:*)",
      "Bash(dune fmt:*)",
      "Bash(make build:*)",
      "Bash(make test:*)",
      "Bash(make format:*)",
      "Bash(make format-check:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(command -v:*)",
      "Bash(shellcheck:*)",
      "Bash(jq:*)",
      "Bash(npm run type-check)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:ocaml.org)",
      "WebFetch(domain:dune.readthedocs.io)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(shred:*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(git *--force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git branch -f*)",
      "Bash(git *--no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(*.ssh/id_*)",
      "Bash(*.aws/credentials*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-fable-5-1",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/auto-improve.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/auto-improve.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dcg"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts",
    "padding": 0
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "in-process",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "plansDirectory": ".workplace/plans",
  "teammateDefaultModel": "sonnet",
  "useAutoModeDuringPlan": true,
  "inputNeededNotifEnabled": true,
  "fallbackModel": [
    "opus"
  ],
  "includeGitInstructions": false,
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git *",
      "gh *",
      "opam *",
      "playwright-cli *"
    ],
    "network": {
      "allowLocalBinding": true
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" },
        { "path": "~/.aws/credentials", "mode": "deny" }
      ]
    }
  }
}
