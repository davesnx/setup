{
  "model": "claude-fable-5-1",
  "effortLevel": "xhigh",
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.ts",
    "padding": 0
  },
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "includeCoAuthoredBy": false,
  "respectGitignore": false,
  "cleanupPeriodDays": 365,
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "in-process",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "USE_BUILTIN_RIPGREP": "1",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "BASH_MAX_OUTPUT_LENGTH": "60000",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(opam exec:*)",
      "Bash(opam list:*)",
      "Bash(opam show:*)",
      "Bash(opam switch list:*)",
      "Bash(dune build:*)",
      "Bash(dune test:*)",
      "Bash(dune fmt:*)",
      "Bash(make build:*)",
      "Bash(make test:*)",
      "Bash(make format:*)",
      "Bash(make format-check:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(sed -n:*)",
      "Bash(command -v:*)",
      "Bash(shellcheck:*)",
      "Bash(jq:*)",
      "Bash(npm run type-check)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:ocaml.org)",
      "WebFetch(domain:dune.readthedocs.io)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(shred:*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(git *--force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -f*)",
      "Bash(git switch -f*)",
      "Bash(git branch -f*)",
      "Bash(git *--no-verify*)",
      "Bash(git *core.hooksPath*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Bash(*.ssh/id_*)",
      "Bash(*.aws/credentials*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dcg"
          }
        ]
      }
    ]
  }
}
