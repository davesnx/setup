#!/usr/bin/env node

const fs = require("node:fs")
const YAML = require("yaml")

function parseArgs(argv) {
  const options = { raw: false, format: "yaml", expression: ".", file: null }
  const positional = []

  for (let index = 0; index < argv.length; index += 1) {
    const argument = argv[index]
    if (argument === "-r") {
      options.raw = true
    } else if (argument === "--version") {
      options.version = true
    } else if (argument.startsWith("-o=")) {
      options.format = argument.slice(3)
    } else if (argument === "-o" || argument === "--output-format") {
      options.format = argv[index + 1]
      index += 1
    } else if (argument.startsWith("--output-format=")) {
      options.format = argument.split("=", 2)[1]
    } else {
      positional.push(argument)
    }
  }

  if (positional[0]) options.expression = positional[0]
  if (positional[1]) options.file = positional[1]
  return options
}

function navigate(data, expression) {
  const path = expression.replace(/^\./, "")
  if (!path) return data

  const parts = []
  for (const match of path.matchAll(/([^.[\]]+)|\[([^\]]*)\]/g)) {
    parts.push(match[1] ?? `[${match[2]}]`)
  }

  let current = data
  for (const part of parts) {
    if (part.startsWith("[")) {
      const key = part.slice(1, -1)
      if (key === "") return Array.isArray(current) ? current : undefined
      current = current?.[Number(key)]
    } else {
      current = current?.[part]
    }
    if (current === undefined || current === null) return current
  }
  return current
}

function parseFallback(value) {
  if (value === "empty" || value === "null") return undefined
  if (value === "true") return true
  if (value === "false") return false
  if (value === "[]") return []
  if (value === "{}") return {}
  if (/^(['"]).*\1$/.test(value)) return value.slice(1, -1)
  const number = Number(value)
  return Number.isNaN(number) ? value : number
}

function evaluate(data, expression) {
  const normalized = expression.trim()
  const fallbackIndex = normalized.indexOf("//")
  if (fallbackIndex !== -1) {
    const primary = evaluate(data, normalized.slice(0, fallbackIndex))
    return primary === undefined || primary === null || primary === ""
      ? parseFallback(normalized.slice(fallbackIndex + 2).trim())
      : primary
  }

  if (normalized.endsWith("| length")) {
    const value = evaluate(data, normalized.slice(0, -"| length".length))
    if (value === undefined || value === null) return 0
    return value.length ?? Object.keys(value).length
  }

  if (normalized.endsWith("[]?") || normalized.endsWith("[]")) {
    const suffixLength = normalized.endsWith("[]?") ? 3 : 2
    const value = evaluate(data, normalized.slice(0, -suffixLength))
    if (value === undefined || value === null) return []
    return Array.isArray(value) ? value : Object.values(value)
  }

  return navigate(data, normalized)
}

function print(result, options) {
  const iterates = !options.expression.includes("//") &&
    (options.expression.trim().endsWith("[]") || options.expression.trim().endsWith("[]?"))
  if (iterates && Array.isArray(result)) {
    for (const item of result) print(item, { ...options, expression: "." })
    return
  }

  if (options.raw) {
    if (result === undefined || result === null) return
    if (typeof result === "object") console.log(JSON.stringify(result))
    else console.log(String(result))
    return
  }

  if (options.format === "json") console.log(JSON.stringify(result ?? null))
  else process.stdout.write(YAML.stringify(result ?? null))
}

const options = parseArgs(process.argv.slice(2))
if (options.version) {
  console.log("node-yq-shim 0.2.0")
  process.exit(0)
}

const input = options.file ? fs.readFileSync(options.file, "utf8") : fs.readFileSync(0, "utf8")
print(evaluate(YAML.parse(input), options.expression), options)
