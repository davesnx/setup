--- /dev/null
+++ b/scripts/eval/tests/cleanup.sh
@@ -0,0 +1,87 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+script=$(CDPATH='' cd "$(dirname "$0")/.." && pwd)/cleanup.sh
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+
+make_run() {
+  local state=$1 id=$2
+  mkdir -p "$state/runs/$id/case/sandbox" "$state/runs/$id/case/stability/sample-2/sandbox" \
+    "$state/runs/$id/case/workdir/sandbox"
+  printf 'transcript\n' > "$state/runs/$id/case/transcript.jsonl"
+  printf 'fixture\n' > "$state/runs/$id/case/workdir/input.txt"
+}
+
+for mode in normal debug failure; do
+  state="$work/$mode state"
+  make_run "$state" run
+  expected=12
+  debug=0
+  [[ "$mode" != debug ]] || { expected=0; debug=1; }
+  [[ "$mode" != failure ]] || expected=13
+  code=0
+  bash -c '
+    set -euo pipefail
+    source "$1"
+    STATE_DIR=$2 RUN_ID=run DEBUG=$3
+    : > "$STATE_DIR/runs/run/.active"
+    trap '\''cleanup_on_exit "$STATE_DIR" "$RUN_ID" "$DEBUG"'\'' EXIT
+    exit "$4"
+  ' _ "$script" "$state" "$debug" "$expected" || code=$?
+  [[ "$code" == "$expected" ]]
+  [[ ! -e "$state/runs/run/.active" && -f "$state/runs/run/.finished" ]]
+  [[ -f "$state/runs/run/case/transcript.jsonl" && -d "$state/runs/run/case/workdir/sandbox" ]]
+  if [[ "$debug" == 1 ]]; then
+    [[ -d "$state/runs/run/case/sandbox" ]]
+    EVAL_STATE_DIR="$state" bash "$script" cleanup --run=run >/dev/null
+  fi
+  [[ ! -e "$state/runs/run/case/sandbox" && ! -e "$state/runs/run/case/stability/sample-2/sandbox" ]]
+done
+
+state="$work/manual"
+make_run "$state" complete
+make_run "$state" sibling
+printf '{"run_id":"complete","cases":[]}' > "$state/runs/complete/results.json"
+EVAL_STATE_DIR="$state" bash "$script" cleanup --run=complete >/dev/null
+EVAL_STATE_DIR="$state" bash "$script" cleanup --run=complete >/dev/null
+[[ -d "$state/runs/sibling/case/sandbox" && -f "$state/runs/complete/results.json" ]]
+
+for id in sibling ../outside /absolute . hidden/child; do
+  if EVAL_STATE_DIR="$state" bash "$script" cleanup "--run=$id" >/dev/null 2>&1; then
+    printf 'Accepted unsafe or unverified run: %s\n' "$id" >&2; exit 1
+  fi
+done
+make_run "$state" active
+printf '{"run_id":"active","cases":[]}' > "$state/runs/active/results.json"
+: > "$state/runs/active/.active"
+if EVAL_STATE_DIR="$state" bash "$script" cleanup --run=active >/dev/null 2>&1; then exit 1; fi
+[[ -d "$state/runs/active/case/sandbox" ]]
+
+mkdir -p "$work/outside/sandbox"
+printf 'keep\n' > "$work/outside/sandbox/keep"
+for component in case stability sample sandbox run runs; do
+  state="$work/link-$component"
+  make_run "$state" target
+  : > "$state/runs/target/.finished"
+  case "$component" in
+    case) ln -s "$work/outside" "$state/runs/target/linked-case" ;;
+    stability) mkdir -p "$work/outside/sample-1/sandbox" "$state/runs/target/linked-case";
+      ln -s "$work/outside" "$state/runs/target/linked-case/stability" ;;
+    sample) ln -s "$work/outside" "$state/runs/target/case/stability/sample-link" ;;
+    sandbox) mkdir "$state/runs/target/linked-case";
+      ln -s "$work/outside/sandbox" "$state/runs/target/linked-case/sandbox" ;;
+    run) mv "$state/runs/target" "$state/moved"; ln -s "$state/moved" "$state/runs/target" ;;
+    runs) mv "$state/runs" "$state/moved"; ln -s "$state/moved" "$state/runs" ;;
+  esac
+  if EVAL_STATE_DIR="$state" bash "$script" cleanup --run=target >/dev/null 2>&1; then
+    printf 'Accepted symlink: %s\n' "$component" >&2; exit 1
+  fi
+  [[ -f "$work/outside/sandbox/keep" && -d "$state/runs/target/case/sandbox" ]]
+done
+
+bash "$script" --help >/dev/null
+for argument in '' --all --run=../bad; do
+  if EVAL_STATE_DIR="$work" bash "$script" "$argument" >/dev/null 2>&1; then exit 1; fi
+done
+printf 'PASS: automatic and manual cleanup preserve status, reports, workdirs, and active runs\n'
