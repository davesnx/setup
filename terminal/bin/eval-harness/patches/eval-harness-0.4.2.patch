@@ -0,0 +1,35 @@
+#!/usr/bin/env python3
+"""Copy candidate inputs without following links or including evaluation files."""
+
+import os
+from pathlib import Path
+import shutil
+import stat
+import sys
+
+
+def copy_tree(source, destination, skill=False):
+    source = Path(source)
+    destination = Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    for entry in source.iterdir():
+        if skill and entry.name == "evals":
+            continue
+        mode = entry.lstat().st_mode
+        target = destination / entry.name
+        if stat.S_ISDIR(mode):
+            copy_tree(entry, target, skill)
+        elif stat.S_ISREG(mode):
+            if target.is_symlink():
+                raise ValueError(f"unsafe destination: {target}")
+            shutil.copyfile(entry, target)
+            os.chmod(target, stat.S_IMODE(mode) & 0o777)
+        else:
+            raise ValueError(f"links and special files are not supported: {entry}")
+
+
+if __name__ == "__main__":
+    try:
+        copy_tree(sys.argv[1], sys.argv[2], "--skill" in sys.argv[3:])
+    except (OSError, ValueError) as error:
+        sys.exit(f"candidate copy: {error}")
