diff --git a/scripts/eval/lib/transcript.sh b/scripts/eval/lib/transcript.sh
new file mode 100644
index 0000000..9879ea1
--- /dev/null
+++ b/scripts/eval/lib/transcript.sh
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+transcript_error() {
+  if [[ ! -s "$1" ]]; then
+    printf '%s\n' 'empty transcript'
+    return
+  fi
+  jq -Rrs '
+    split("\n") | map(select(test("\\S")) | fromjson) |
+    if length == 0 then "empty transcript"
+    elif any(.[]; type != "object") then "invalid event"
+    elif any(.[]; (.type | type) != "string") then "invalid event"
+    elif any(.[]; .type == "error") then "model error"
+    elif .[-1].type != "step_finish" or .[-1].part.reason != "stop"
+      then "incomplete transcript"
+    else "" end
+  ' "$1" 2>/dev/null || printf '%s\n' 'malformed JSONL'
+}
+
+transcript_metrics() {
+  jq -s '
+    def sum_known:
+      if length == 0 or any(.[]; type != "number" or . < 0) then null else add end;
+    [.[] | select(.type == "step_finish")] as $steps |
+    [.[] | select(.type == "step_start") | .timestamp | numbers] as $starts |
+    [$steps[] | .timestamp | numbers] as $ends |
+    if ($steps | length) > 0 then
+      {
+        format: "opencode",
+        steps: ($steps | length),
+        tokens: {
+          input: ([$steps[].part.tokens.input] | sum_known),
+          output: ([$steps[].part.tokens.output] | sum_known),
+          reasoning: ([$steps[].part.tokens.reasoning] | sum_known),
+          cache_read: ([$steps[].part.tokens.cache.read] | sum_known),
+          cache_write: ([$steps[].part.tokens.cache.write] | sum_known)
+        },
+        cost: {usd: ([$steps[].part.cost] | sum_known), source: "opencode_estimate"},
+        elapsed_ms: (if ($starts | length) > 0 and ($ends | length) > 0
+          then ($ends | max) - ($starts | min) else null end)
+      }
+    else
+      [.[] | .usage? | objects] as $usage |
+      {
+        format: (if ($usage | length) > 0 then "legacy" else "unknown" end),
+        steps: 0,
+        tokens: {
+          input: ([$usage[] | .input_tokens // .prompt_tokens] | sum_known),
+          output: ([$usage[] | .output_tokens // .completion_tokens] | sum_known),
+          reasoning: null, cache_read: null, cache_write: null
+        },
+        cost: {usd: null, source: null}, elapsed_ms: null
+      }
+    end
