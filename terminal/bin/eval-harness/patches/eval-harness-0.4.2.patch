diff --git a/scripts/eval/lib/transcript.sh b/scripts/eval/lib/transcript.sh
new file mode 100644
index 0000000..9879ea1
--- /dev/null
+++ b/scripts/eval/lib/transcript.sh
@@ -0,0 +1,67 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+transcript_error() {
+  if [[ ! -s "$1" ]]; then
+    printf '%s\n' 'empty transcript'
+    return
+  fi
+  jq -Rrs '
+    split("\n") | map(select(test("\\S")) | fromjson) |
+    if length == 0 then "empty transcript"
+    elif any(.[]; type != "object") then "invalid event"
+    elif any(.[]; (.type | type) != "string") then "invalid event"
+    elif any(.[]; .type == "error") then "model error"
+    elif .[-1].type != "step_finish" or .[-1].part.reason != "stop"
+      then "incomplete transcript"
+    else "" end
+  ' "$1" 2>/dev/null || printf '%s\n' 'malformed JSONL'
+}
+
+transcript_metrics() {
+  jq -s '
+    def sum_known:
+      if length == 0 or any(.[]; type != "number" or . < 0) then null else add end;
+    [.[] | select(.type == "step_finish")] as $steps |
+    [.[] | select(.type == "step_start") | .timestamp | numbers] as $starts |
+    [$steps[] | .timestamp | numbers] as $ends |
+    if ($steps | length) > 0 then
+      {
+        format: "opencode",
+        steps: ($steps | length),
+        tokens: {
+          input: ([$steps[].part.tokens.input] | sum_known),
+          output: ([$steps[].part.tokens.output] | sum_known),
+          reasoning: ([$steps[].part.tokens.reasoning] | sum_known),
+          cache_read: ([$steps[].part.tokens.cache.read] | sum_known),
+          cache_write: ([$steps[].part.tokens.cache.write] | sum_known)
+        },
+        cost: {usd: ([$steps[].part.cost] | sum_known), source: "opencode_estimate"},
+        elapsed_ms: (if ($starts | length) > 0 and ($ends | length) > 0
+          then ($ends | max) - ($starts | min) else null end)
+      }
+    else
+      [.[] | .usage? | objects] as $usage |
+      {
+        format: (if ($usage | length) > 0 then "legacy" else "unknown" end),
+        steps: 0,
+        tokens: {
+          input: ([$usage[] | .input_tokens // .prompt_tokens] | sum_known),
+          output: ([$usage[] | .output_tokens // .completion_tokens] | sum_known),
+          reasoning: null, cache_read: null, cache_write: null
+        },
+        cost: {usd: null, source: null}, elapsed_ms: null
+      }
+    end
+  ' "$@"
+}
+
+export -f transcript_error transcript_metrics
+
+if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
+  case "${1:-}" in
+    validate) shift; transcript_error "$@" ;;
+    measure) shift; transcript_metrics "$@" ;;
+    *) printf 'usage: transcript.sh {validate|measure} <transcript>\n' >&2; exit 2 ;;
+  esac
+fi
diff --git a/scripts/eval/regrade.sh b/scripts/eval/regrade.sh
new file mode 100644
--- /dev/null
+++ b/scripts/eval/regrade.sh
@@ -0,0 +1,84 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+REGRADING_DIR=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+source "$REGRADING_DIR/cleanup.sh"
+source "$REGRADING_DIR/lib/skills_root.sh"
+source "$REGRADING_DIR/lib/score.sh"
+
+run_id=''
+case_id=''
+for argument in "$@"; do
+  case "$argument" in
+    regrade) ;;
+    --run=*) run_id=${argument#*=} ;;
+    --case=*) case_id=${argument#*=} ;;
+    --help|-h)
+      printf 'Usage: eval-harness regrade --run=<run-id> --case=<case-id>\n\nRegrade all saved attempts of one case with its current YAML checks.\nNo candidate is invoked. Writes a separate report under state/regrades/.\nRequires sealed, finished evidence from the current harness.\nEVAL_WARN_ONLY=1 returns 0 for failed assertions, never errors.\n'
+      exit 0 ;;
+    *) printf 'regrade: unknown argument: %s\n' "$argument" >&2; exit 2 ;;
+  esac
+done
+[[ -n "$run_id" && "$case_id" =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] || { printf 'regrade: --run and a valid --case are required\n' >&2; exit 2; }
+state=${EVAL_STATE_DIR:-$HOME/.config/opencode/eval-harness}
+run=$(cleanup_run_path "$state" "$run_id") || exit 13
+[[ ! -L "$state/regrades" ]] || { printf 'regrade: unsafe report directory\n' >&2; exit 13; }
+mkdir -p "$state/regrades"
+report=$(mktemp -d "$state/regrades/$run_id-$case_id.XXXXXX")
+trap 'code=$?; if [[ $code != 0 && ! -f "$report/report.json" ]]; then rm -rf -- "$report"; fi' EXIT
+python3 "$REGRADING_DIR/lib/evidence.py" snapshot "$run" "$report/source" > "$report/source-evidence.json" || exit 13
+jq -e --arg case_id "$case_id" '.cases | index($case_id) != null' "$report/source-evidence.json" >/dev/null || { printf 'regrade: case is not in the source run\n' >&2; exit 13; }
+skill=$(jq -r '.skill' "$report/source-evidence.json")
+root=$(resolve_skills_root "$skill") || exit 13
+case_files=()
+for candidate in "$root/$skill/evals/cases/"*.yaml; do
+  [[ -f "$candidate" ]] || continue
+  if [[ "$(yq -r '.id' "$candidate")" == "$case_id" ]]; then case_files+=("$candidate"); fi
+done
+[[ ${#case_files[@]} == 1 ]] || { printf 'regrade: current YAML case missing or ambiguous\n' >&2; exit 13; }
+cp "${case_files[0]}" "$report/current-case.yaml"
+export EVAL_FIXTURE_DIR="$root/$skill/evals/fixtures"
+evidence="$report/source/$case_id"
+attempt_dirs=("$evidence")
+for attempt in "$evidence"/stability/sample-* "$evidence"/repetitions/sample-*; do
+  [[ -d "$attempt" ]] && attempt_dirs+=("$attempt")
+done
+
+# Validate every saved attempt before running any current check.
+for attempt in "${attempt_dirs[@]}"; do
+  [[ -d "$attempt/workdir" && -f "$attempt/exit-code" && "$(<"$attempt/exit-code")" == 0 ]] || { printf 'regrade: incomplete or failed candidate attempt\n' >&2; exit 13; }
+  problem=$(transcript_error "$attempt/transcript.jsonl")
+  [[ -z "$problem" ]] || { printf 'regrade: %s\n' "$problem" >&2; exit 13; }
+done
+results=()
+index=0
+for attempt in "${attempt_dirs[@]}"; do
+  index=$((index + 1))
+  attempt_name=${attempt#"$evidence"}
+  attempt_name=${attempt_name#/}
+  attempt_name=${attempt_name:-primary}
+  # The scorer may write files. Its working copy is distinct from the snapshot.
+  grading_dir="$report/attempts/$index"
+  mkdir -p "$grading_dir"
+  cp -R "$attempt/workdir" "$grading_dir/workdir"
