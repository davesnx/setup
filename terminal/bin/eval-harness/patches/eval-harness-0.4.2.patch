+++ b/scripts/eval/tests/transcript_contract.sh
@@ -0,0 +1,124 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT=$(CDPATH='' cd "$(dirname "$0")/../../.." && pwd)
+source "$ROOT/scripts/eval/lib/transcript.sh"
+WORK=$(mktemp -d)
+trap 'rm -rf "$WORK"' EXIT
+
+cat > "$WORK/good" <<'JSONL'
+{"type":"step_start","timestamp":1000}
+{"type":"step_finish","timestamp":2000,"part":{"reason":"tool-calls","tokens":{"input":3,"output":10,"reasoning":2,"cache":{"read":0,"write":100}},"cost":0.125}}
+{"type":"step_start","timestamp":2100}
+{"type":"text","part":{"text":"answer"}}
+{"type":"step_finish","timestamp":3000,"part":{"reason":"stop","tokens":{"input":1,"output":20,"reasoning":3,"cache":{"read":100,"write":0}},"cost":0.25}}
+JSONL
+transcript_metrics "$WORK/good" | jq -e '
+  .steps == 2 and .tokens == {input:4,output:30,reasoning:5,cache_read:100,cache_write:100}
+  and .cost.usd == 0.375 and .elapsed_ms == 2000
+' >/dev/null
+[[ -z "$(transcript_error "$WORK/good")" ]]
+transcript_metrics "$WORK/good" "$WORK/good" | jq -e '.tokens.input == 8 and .cost.usd == 0.75' >/dev/null
+
+jq -c 'if .type == "step_finish" then del(.part.cost) else . end' "$WORK/good" > "$WORK/unknown-cost"
+transcript_metrics "$WORK/unknown-cost" | jq -e '.cost.usd == null' >/dev/null
+jq -c 'if .type == "step_finish" then .part.cost = 0 else . end' "$WORK/good" > "$WORK/zero-cost"
+transcript_metrics "$WORK/zero-cost" | jq -e '.cost.usd == 0' >/dev/null
+transcript_metrics "$WORK/good" "$WORK/unknown-cost" | jq -e '.cost.usd == null' >/dev/null
+
+cp "$WORK/good" "$WORK/error"
+printf '%s\n' '{"type":"error","error":{"message":"failed after useful output"}}' >> "$WORK/error"
+cp "$WORK/good" "$WORK/incomplete"
+printf '%s\n' '{"type":"step_start","timestamp":4000}' >> "$WORK/incomplete"
+printf '%s\n' '{"type":"tool_use","part":{"state":{"output":"answer"}}}' > "$WORK/tool-only"
+printf '%s\n' 'not JSON' > "$WORK/malformed"
+printf '%s\n' 'null' > "$WORK/scalar"
+printf ' \n' > "$WORK/blank"
+: > "$WORK/empty"
+for name in error incomplete tool-only malformed scalar blank empty; do
+  [[ -n "$(transcript_error "$WORK/$name")" ]] || { printf 'Accepted %s\n' "$name" >&2; exit 1; }
+done
+if transcript_metrics "$WORK/malformed" >/dev/null 2>&1; then
+  printf 'Malformed metrics were accepted\n' >&2; exit 1
+fi
+
+mkdir -p "$WORK/bin" "$WORK/primary/shared" "$WORK/extra/private/evals/cases"
+cat > "$WORK/bin/opencode" <<'SH'
+#!/usr/bin/env bash
+if [[ "${1:-}" == --version ]]; then printf '1.18.27-test\n'; exit; fi
+[[ -d "$OPENCODE_CONFIG_DIR/skills/shared" && -d "$OPENCODE_CONFIG_DIR/skills/private" ]] || exit 99
+cat "$TRACE_FILE"
+if [[ "${TRACE_FAIL_SAMPLES:-0}" == 1 && "$PWD" == */stability/* ]]; then exit 7; fi
+exit "${TRACE_EXIT:-0}"
+SH
+chmod +x "$WORK/bin/opencode"
+cat > "$WORK/extra/private/evals/cases/one.yaml" <<'YAML'
+id: one
+skills_loaded: [shared, private]
+prompt: test
+checks:
+  - kind: output_contains
+    value: answer
+YAML
+export PATH="$WORK/bin:$PATH" OPENCODE_SKILLS_ROOT="$WORK/primary" OPENCODE_SKILLS_EXTRA_ROOT="$WORK/extra"
+export EVAL_SKIP_AUTH_CHECK=1 EVAL_MAX_SECONDS=5 EVAL_AUTOFIX=0
+for name in good error incomplete tool-only malformed scalar blank empty unknown-cost zero-cost; do
+  export TRACE_FILE="$WORK/$name" EVAL_STATE_DIR="$WORK/state-$name"
+  code=0
+  bash "$ROOT/scripts/eval/run.sh" --skill=private --case=one > "$WORK/$name.log" 2>&1 || code=$?
+  expected=13
+  case "$name" in good|unknown-cost|zero-cost) expected=0 ;; esac
+  [[ "$code" == "$expected" ]] || { cat "$WORK/$name.log" >&2; exit 1; }
+done
+for name in unknown-cost zero-cost; do
+  expected=null
+  [[ "$name" != zero-cost ]] || expected=0
+  jq -e --argjson expected "$expected" '.summary.total_cost_usd == $expected' "$WORK/state-$name"/runs/*/results.json >/dev/null
+done
+jq -e '.cases[0].metrics.tokens.cache_read == 100 and .summary.total_cost_usd == 0.375' "$WORK/state-good"/runs/*/results.json >/dev/null
+
+export TRACE_FILE="$WORK/good" TRACE_EXIT=7 EVAL_STATE_DIR="$WORK/state-exit"
+code=0
+bash "$ROOT/scripts/eval/run.sh" --skill=private --case=one > "$WORK/exit.log" 2>&1 || code=$?
+[[ "$code" == 13 ]] || { cat "$WORK/exit.log" >&2; exit 1; }
+unset TRACE_EXIT
+export TRACE_FILE="$WORK/error" EVAL_STATE_DIR="$WORK/state-error"
