diff --git a/scripts/eval/lib/evidence.py b/scripts/eval/lib/evidence.py
new file mode 100644
--- /dev/null
+++ b/scripts/eval/lib/evidence.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Seal completed evidence and copy verified evidence for offline regrading.
+
+Hashes detect changed files, not an attacker who can rewrite the seal itself.
+"""
+
+import hashlib
+import json
+from pathlib import Path
+import re
+import shutil
+import stat
+import sys
+
+
+def identifier(value):
+    if not isinstance(value, str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", value):
+        raise ValueError(f"invalid evidence ID: {value!r}")
+    return value
+
+
+def read_json(path):
+    if path.is_symlink() or not path.is_file():
+        raise ValueError(f"missing or unsafe record: {path}")
+    return json.loads(path.read_text())
+
+
+def inventory(run, cases):
+    files = {}
+
+    def visit(directory):
+        for path in sorted(directory.iterdir()):
+            relative = path.relative_to(run)
+            parts = relative.parts
+            if len(parts) == 1 and path.name in {".active", ".finished", "evidence.json"}:
+                continue
+            if parts[0] in cases and path.name == "sandbox" and (
+                len(parts) == 2 or (len(parts) == 4 and parts[1] in {"stability", "repetitions"}
+                                    and re.fullmatch(r"sample-[1-9][0-9]*", parts[2]))
+            ):
+                continue
+            mode = path.lstat().st_mode
+            if stat.S_ISDIR(mode):
+                files[str(relative)] = "directory"
+                visit(path)
+            elif stat.S_ISREG(mode):
+                files[str(relative)] = hashlib.sha256(path.read_bytes()).hexdigest()
+            else:
+                raise ValueError(f"unsafe evidence path (link or special file): {relative}")
+
+    visit(run)
+    return files
+
+
+def case_ids(results, run):
+    if results.get("run_id") != run.name or not isinstance(results.get("cases"), list) or not results["cases"]:
+        raise ValueError("run identity or case list is missing")
+    ids = [identifier(case["case_id"]) for case in results["cases"]]
+    if len(ids) != len(set(ids)):
+        raise ValueError("duplicate case IDs")
+    return ids
+
+
+def finished(run):
+    if run.is_symlink() or (run / ".active").exists() or (run / ".active").is_symlink():
+        raise ValueError("run is active, interrupted, or unsafe")
+    marker = run / ".finished"
+    if marker.is_symlink() or not marker.is_file() or marker.read_text().strip() not in {"0", "12"}:
+        raise ValueError("run has no successful completion record (harness errors cannot be regraded)")
+
+
+def main():
+    command, source, argument = sys.argv[1:]
+    run = Path(source)
+    identifier(run.name)
+    if run.is_symlink():
+        raise ValueError("symlink run rejected")
+    results = read_json(run / "results.json")
+    cases = case_ids(results, run)
+    if command == "seal":
+        record = {"schema_version": 1, "run_id": run.name, "skill": identifier(argument),
+                  "cases": cases, "files": inventory(run, cases)}
+        with (run / "evidence.json").open("x") as output:
+            json.dump(record, output, indent=2)
+        return
+    if command != "snapshot":
+        raise ValueError("expected seal or snapshot")
+    finished(run)
+    record = read_json(run / "evidence.json")
+    identifier(record["skill"])
+    if record.get("schema_version") != 1 or record.get("run_id") != run.name or record.get("cases") != cases:
+        raise ValueError("evidence identity does not match results")
+    files = inventory(run, cases)
+    if record.get("files") != files:
+        raise ValueError("evidence changed or is incomplete: checksum mismatch")
+    for case in cases:
+        for required in ("workdir", "transcript.jsonl", "checks.json", "exit-code", "case.yaml", "env-manifest.json"):
+            if f"{case}/{required}" not in files:
+                raise ValueError(f"incomplete case evidence: {case}/{required}")
+    target = Path(argument)
+    target.mkdir()
+    for name, digest in files.items():
+        destination = target / name
+        if digest == "directory":
+            destination.mkdir(parents=True, exist_ok=True)
+        else:
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(run / name, destination)
+            destination.chmod(stat.S_IMODE((run / name).stat().st_mode) & 0o777)
+    if inventory(target, cases) != files:
+        raise ValueError("evidence changed while copying")
+    finished(run)
+    print(json.dumps(record))
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        sys.exit(f"regrade evidence: {error}")
