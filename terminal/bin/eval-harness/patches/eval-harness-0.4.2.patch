new file mode 100644
--- /dev/null
+++ b/scripts/eval/cleanup.sh
@@ -0,0 +1,93 @@
+#!/usr/bin/env bash
+
+cleanup_run_path() {
+  local state=$1 id=$2
+  if [[ ! $id =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]]; then
+    printf 'cleanup: invalid run ID: %s\n' "$id" >&2
+    return 2
+  fi
+  if [[ ! -d "$state" || -L "$state/runs" || -L "$state/runs/$id" || ! -d "$state/runs/$id" ]]; then
+    printf 'cleanup: run missing or unsafe: %s\n' "$id" >&2
+    return 1
+  fi
+  state=$(CDPATH='' cd -- "$state" && pwd -P) || return
+  printf '%s/runs/%s\n' "$state" "$id"
+}
+
+cleanup_sandboxes() {
+  local run=$1 target parent
+  local targets=()
+  for target in "$run"/*/sandbox "$run"/*/stability/sample-*/sandbox "$run"/*/repetitions/sample-*/sandbox; do
+    [[ -e "$target" || -L "$target" ]] || continue
+    parent=$target
+    while [[ "$parent" != "$run" ]]; do
+      if [[ -L "$parent" ]]; then
+        printf 'cleanup: symlink rejected: %s\n' "$parent" >&2
+        return 1
+      fi
+      parent=${parent%/*}
+    done
+    if [[ ! -d "$target" ]]; then
+      printf 'cleanup: not a sandbox directory: %s\n' "$target" >&2
+      return 1
+    fi
+    targets+=("$target")
+  done
+  # Check every path before deleting any of them.
+  if (( ${#targets[@]} > 0 )); then
+    rm -rf -- "${targets[@]}"
+  fi
+}
+
+cleanup_on_exit() {
+  local code=$? state=$1 id=$2 debug=$3 run
+  trap - EXIT
+  if run=$(cleanup_run_path "$state" "$id"); then
+    if [[ $debug == 0 ]]; then
+      cleanup_sandboxes "$run" || printf '[eval-harness] warning: cleanup failed for %s\n' "$id" >&2
+    fi
+    if [[ ! -L "$run/.finished" && ! -L "$run/.active" ]]; then
+      printf '%s\n' "$code" > "$run/.finished" || printf 'cleanup: could not mark run finished\n' >&2
+      rm -f -- "$run/.active" || printf 'cleanup: could not remove activity marker\n' >&2
+    else
+      printf 'cleanup: unsafe run marker; leaving it unchanged\n' >&2
+    fi
+  fi
+  exit "$code"
+}
+
+if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
+  set -euo pipefail
+  run_id=''
+  for argument in "$@"; do
+    case "$argument" in
+      cleanup) ;;
+      --run=*)
+        [[ -z "$run_id" ]] || { printf 'cleanup: specify one run ID\n' >&2; exit 2; }
+        run_id=${argument#*=} ;;
+      --help|-h)
+        printf 'Usage: eval-harness cleanup --run=<run-id>\n\nRemove sandbox directories from one finished run.\nReports, transcripts, workdirs, and other runs are kept.\n'
+        exit 0 ;;
+      *) printf 'cleanup: unknown argument: %s\n' "$argument" >&2; exit 2 ;;
+    esac
+  done
+  [[ -n "$run_id" ]] || { printf 'cleanup: --run=<run-id> is required\n' >&2; exit 2; }
+  state=${EVAL_STATE_DIR:-$HOME/.config/opencode/eval-harness}
+  run=$(cleanup_run_path "$state" "$run_id")
+  if [[ -e "$run/.active" || -L "$run/.active" ]]; then
+    printf 'cleanup: run is active or was interrupted: %s\n' "$run_id" >&2
+    exit 1
+  fi
+  if [[ -L "$run/.finished" || -L "$run/results.json" ]]; then
+    printf 'cleanup: unsafe completion record\n' >&2
+    exit 1
+  fi
+  # Runs made before activity markers were added have only results.json.
+  if [[ ! -f "$run/.finished" ]] && ! jq -e --arg id "$run_id" \
+      '.run_id == $id and (.cases | type) == "array"' "$run/results.json" >/dev/null 2>&1; then
+    printf 'cleanup: cannot verify that run finished: %s\n' "$run_id" >&2
+    exit 1
+  fi
+  cleanup_sandboxes "$run"
+  printf '[eval-harness] cleanup: sandboxes removed for %s\n' "$run_id"
+fi
