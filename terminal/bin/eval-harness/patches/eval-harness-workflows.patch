@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Validate workflow selection and case inputs before candidate execution."""
+
+import json
+from pathlib import Path
+import re
+import sys
+
+
+def identifier(value):
+    if not isinstance(value, str) or not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9_.-]*", value):
+        raise ValueError("invalid task or skill ID")
+    return value
+
+
+def local_path(root, name):
+    if not isinstance(name, str) or not name or Path(name).is_absolute() or ".." in Path(name).parts:
+        raise ValueError("expected a nonempty relative path without '..'")
+    target = (root / name).resolve(strict=True)
+    if not target.is_relative_to(root.resolve()) or not target.is_file():
+        raise ValueError("path must be a file inside the task eval directory")
+    return str(target)
+
+
+def review_metadata(directory):
+    path = directory / "metadata.json"
+    if path.is_symlink():
+        raise ValueError("task metadata cannot be a link")
+    if not path.exists():
+        return None
+    metadata = json.loads(path.read_text())
+    if not isinstance(metadata, dict) or set(metadata) != {"manual_review", "artifact", "criteria"} or type(metadata["manual_review"]) is not bool:
+        raise ValueError("metadata requires manual_review (boolean), artifact, and criteria")
+    artifact = metadata["artifact"]
+    if not isinstance(artifact, str) or not artifact.strip() or not Path(artifact).parts or Path(artifact).is_absolute() or ".." in Path(artifact).parts or any(c in artifact for c in "\0\n\r"):
+        raise ValueError("review artifact must be a relative path inside the workdir")
+    criteria = metadata["criteria"]
+    if not isinstance(criteria, list) or not criteria or any(not isinstance(c, str) or not c.strip() or "\0" in c for c in criteria):
+        raise ValueError("review criteria must be nonempty strings")
+    return {"required": metadata["manual_review"],
+            "status": "pending" if metadata["manual_review"] else "not_required",
+            "artifact": artifact, "criteria": criteria}
+
+
+def select(root, selector, value):
+    root = Path(root).resolve(strict=True)
+    index = root / "index.json"
+    if index.is_symlink():
+        raise ValueError("workflow index cannot be a link")
+    manifest = json.loads(index.read_text())
+    if not isinstance(manifest, dict) or set(manifest) != {"schema_version", "tasks"} or type(manifest["schema_version"]) is not int or manifest["schema_version"] != 1:
+        raise ValueError("expected workflow schema_version 1 and tasks")
+    tasks = manifest["tasks"]
+    if not isinstance(tasks, list) or not tasks:
+        raise ValueError("tasks must be a nonempty array")
+    ids = set()
+    selected = []
+    for task in tasks:
+        if not isinstance(task, dict) or set(task) != {"id", "skill", "split", "source", "description"}:
+            raise ValueError("invalid task fields (skip flags are not supported)")
+        identifier(task["id"])
+        identifier(task["skill"])
+        if task["id"] in ids:
+            raise ValueError("duplicate task ID: " + task["id"])
+        ids.add(task["id"])
+        if task["split"] not in {"development", "heldout"}:
+            raise ValueError("invalid task split")
+        for field in ("source", "description"):
+            if not isinstance(task[field], str) or not task[field].strip():
+                raise ValueError("task source and description must be nonempty strings")
+        directory = root / "tasks" / task["id"]
+        case_name = f"tasks/{task['id']}/cases/{task['id']}.yaml"
+        if local_path(root, case_name) != str(root / case_name):
+            raise ValueError("workflow case and its control directories cannot be links")
+        if task[selector] == value:
+            selected.append({**task, "evals_dir": str(directory.resolve()), "manual_review": review_metadata(directory)})
+    if not selected:
+        raise ValueError("no workflow tasks match the selector")
+    return selected
+
+
+def case_inputs(data, directory, suite):
+    if not isinstance(data, dict) or ("prompt" in data) == ("turns" in data):
+        raise ValueError("case requires exactly one of prompt or turns")
+    prompts = data["turns"] if "turns" in data else [data["prompt"]]
+    if not isinstance(prompts, list) or not prompts or any(not isinstance(p, str) or not p.strip() or "\0" in p for p in prompts):
+        raise ValueError("prompt/turns must contain nonempty prompt strings")
+    setup = data.get("setup", {})
+    if not isinstance(setup, dict):
+        raise ValueError("setup must be an object")
+    if suite == "workflow":
+        fixtures = setup.get("fixtures", {})
+        if not isinstance(fixtures, dict):
+            raise ValueError("setup.fixtures must be an object")
+        for destination, source in fixtures.items():
+            if not isinstance(destination, str) or not destination or Path(destination).is_absolute() or ".." in Path(destination).parts:
+                raise ValueError("fixture destination must be a relative path inside the workdir")
+            fixture = local_path(Path(directory), source)
+            if fixture == str((Path(directory) / "metadata.json").resolve()):
+                raise ValueError("manual-review metadata cannot be a candidate fixture")
+    script = local_path(Path(directory), setup["script"]) if "script" in setup else ""
+    return {"prompts": prompts, "script": script, "native_turns": "turns" in data}
+
+
+if __name__ == "__main__":
+    try:
+        if sys.argv[1] == "select":
+            result = select(*sys.argv[2:])
+        elif sys.argv[1] == "case":
+            result = case_inputs(json.load(sys.stdin), *sys.argv[2:])
+        else:
+            raise ValueError("unknown workflow operation")
+        print(json.dumps(result))
+    except (OSError, ValueError, KeyError, TypeError) as error:
+        sys.exit(f"workflow: {error}")
