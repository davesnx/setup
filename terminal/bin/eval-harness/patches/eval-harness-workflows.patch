+def relative_link(root, link):
+    """Check every expanded component, never following a link outside this tree."""
+    target = os.readlink(link)
+    pending = deque(link.relative_to(root).parts)
+    resolved = []
+    visited = set()
+    while pending:
+        part = pending.popleft()
+        if part in {"", "."}:
+            continue
+        if part == "..":
+            if not resolved:
+                raise ValueError(f"link escapes input tree: {link}")
+            resolved.pop()
+            continue
+        current = root.joinpath(*resolved, part)
+        if current.is_symlink():
+            value = os.readlink(current)
+            if os.path.isabs(value):
+                raise ValueError(f"absolute link is not supported: {current}")
+            # Check the written target too, including unreachable loop suffixes.
+            lexical = list(resolved)
+            for component in value.split("/"):
+                if component == "..":
+                    if not lexical:
+                        raise ValueError(f"link escapes input tree: {current}")
+                    lexical.pop()
+                elif component not in {"", "."}:
+                    lexical.append(component)
+            if current in visited:
+                return target  # A confined cycle stays a link; copying never traverses it.
+            if len(visited) >= 40:
+                raise ValueError(f"link chain exceeds 40 expansions: {link}")
+            visited.add(current)
+            pending.extendleft(reversed(value.split("/")))
+        else:
+            resolved.append(part)
+    return target
+
