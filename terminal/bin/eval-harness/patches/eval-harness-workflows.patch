+#!/usr/bin/env bash
+set -euo pipefail
+
+WORKFLOW_DIR=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+source "$WORKFLOW_DIR/lib/yq-shim.sh"
+selector=split
+selection=development
+selected=0
+dry=0
+mode=${EVAL_MODE:-full}
+repetitions=${EVAL_REPETITIONS:-1}
+seconds=${EVAL_MAX_SECONDS:-180}
+model=${EVAL_MODEL:-}
+forward=()
+for argument in "$@"; do
+  case "$argument" in
+    workflow) ;;
+    --case=*|--split=*)
+      [[ $selected == 0 ]] || { printf 'workflow: use only one --case or --split selector\n' >&2; exit 2; }
+      selected=1
+      selection=${argument#*=}
+      if [[ $argument == --case=* ]]; then selector=id; else selector=split; fi ;;
+    --dry-run) dry=1 ;;
+    --model=*) model=${argument#*=}; [[ -n $model ]] || exit 2 ;;
+    --mode=*) mode=${argument#*=} ;;
+    --repetitions=*) repetitions=${argument#*=} ;;
+    --max-seconds=*) seconds=${argument#*=} ;;
+    --debug) forward+=(--debug) ;;
+    --help|-h)
+      printf 'Usage: eval-harness workflow [--case=<id> | --split=development|heldout]\n  --dry-run --model=<provider/model> --mode=smoke|full\n  --repetitions=1..20 --max-seconds=1..3600 --debug\nDefaults to development only. Each task has a separate run and result.\n'
+      exit 0 ;;
+    *) printf 'workflow: unknown argument: %s\n' "$argument" >&2; exit 2 ;;
+  esac
+done
+[[ $selector != split || $selection == development || $selection == heldout ]] || exit 2
+[[ $mode == smoke || $mode == full ]] || { printf 'workflow: mode must be smoke or full\n' >&2; exit 2; }
+[[ $repetitions =~ ^[1-9][0-9]?$ && $repetitions -le 20 ]] || { printf 'workflow: repetitions must be 1..20\n' >&2; exit 2; }
+[[ $seconds =~ ^[1-9][0-9]{0,3}$ && $seconds -le 3600 ]] || { printf 'workflow: max-seconds must be 1..3600\n' >&2; exit 2; }
+[[ -n ${EVAL_WORKFLOWS_ROOT:-} ]] || { printf 'workflow: EVAL_WORKFLOWS_ROOT is required\n' >&2; exit 13; }
+tasks=$(python3 "$WORKFLOW_DIR/lib/workflow.py" select "$EVAL_WORKFLOWS_ROOT" "$selector" "$selection") || exit 13
+mapfile -t entries < <(jq -c '.[]' <<< "$tasks")
+# Validate the whole selected group before any task can spend tokens.
+for entry in "${entries[@]}"; do
+  id=$(jq -r '.id' <<< "$entry")
+  directory=$(jq -r '.evals_dir' <<< "$entry")
+  inputs=$(yq -o=json '.' "$directory/cases/$id.yaml" | python3 "$WORKFLOW_DIR/lib/workflow.py" case "$directory" workflow) || exit 13
+  [[ $(yq -r '.id' "$directory/cases/$id.yaml") == "$id" ]] || { printf 'workflow: indexed and YAML case IDs differ\n' >&2; exit 13; }
+  if [[ $dry == 0 && ${EVAL_RUNNER:-host} == docker && $(jq '.native_turns' <<< "$inputs") == true ]]; then
+    printf 'workflow: Docker does not support native turns; use EVAL_RUNNER=host\n' >&2
+    exit 13
+  fi
+done
+if [[ $dry == 1 ]]; then
+  for entry in "${entries[@]}"; do
+    jq -r '"[workflow] [dry-run] \(.id) skill=\(.skill) split=\(.split)"' <<< "$entry"
+  done
+  exit 0
+fi
+[[ ${EVAL_BYPASS:-0} != 1 ]] || { printf 'workflow: EVAL_BYPASS would skip the selected tasks\n' >&2; exit 13; }
+export EVAL_SUITE=workflow EVAL_MAX_SECONDS="$seconds" EVAL_STABILITY_SAMPLES=1
+if [[ -n $model ]]; then export EVAL_MODEL="$model" EVAL_FULL_MODEL="$model" EVAL_SMOKE_MODEL="$model"; fi
+passed=() failed=() errors=() pending=()
+for entry in "${entries[@]}"; do
+  id=$(jq -r '.id' <<< "$entry")
+  skill=$(jq -r '.skill' <<< "$entry")
+  directory=$(jq -r '.evals_dir' <<< "$entry")
+  code=0
+  EVAL_EVALS_DIR="$directory" EVAL_WARN_ONLY=0 bash "$WORKFLOW_DIR/run.sh" \
+    --skill="$skill" --case="$id" --mode="$mode" --repetitions="$repetitions" "${forward[@]}" || code=$?
+  case "$code" in
+    0)
+      if [[ $(jq -r '.manual_review.required // false' <<< "$entry") == true ]]; then
+        pending+=("$id")
+      else
+        passed+=("$id")
+      fi ;;
+    12) failed+=("$id") ;;
+    *) errors+=("$id:$code") ;;
+  esac
+done
+printf '[workflow] PASS (%s): %s\n' "${#passed[@]}" "${passed[*]:-none}"
+printf '[workflow] PENDING MANUAL REVIEW (%s; automatic checks passed): %s\n' "${#pending[@]}" "${pending[*]:-none}"
+printf '[workflow] FAIL (%s): %s\n' "${#failed[@]}" "${failed[*]:-none}"
+printf '[workflow] ERROR (%s): %s\n' "${#errors[@]}" "${errors[*]:-none}"
+[[ ${#errors[@]} == 0 ]] || exit 13
+[[ ${#failed[@]} == 0 ]] || exit 12
