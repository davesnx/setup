@@ -0,0 +1,142 @@
+#!/usr/bin/env python3
+"""Run ordered prompts in one native OpenCode session, with one time budget."""
+
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import sys
+import time
+
+
+def session_id(transcript, expected):
+    events = [json.loads(line) for line in transcript.read_text().splitlines() if line.strip()]
+    ids = {event["sessionID"] for event in events if "sessionID" in event}
+    if len(ids) != 1 or not all(isinstance(value, str) and value.strip() for value in ids):
+        raise ValueError("missing or ambiguous native sessionID")
+    current = ids.pop()
+    if expected is not None and current != expected:
+        raise ValueError("native sessionID changed between turns")
+    return current
+
+
+def transcript_problem(transcript):
+    result = subprocess.run(["bash", str(Path(__file__).with_name("transcript.sh")), "validate", str(transcript)],
+                            text=True, capture_output=True, check=True)
+    return result.stdout.strip()
+
+
+def interrupted(signum, _frame):
+    raise SystemExit(128 + signum)
+
+
+def validate(attempt, prompts):
+    records = json.loads((attempt / "turns.json").read_text())
+    if not isinstance(records, list) or len(records) != len(prompts) or not records:
+        raise ValueError("incomplete turn evidence")
+    session = None
+    combined = b""
+    for number, record in enumerate(records, 1):
+        directory = attempt / "turns" / str(number)
+        transcript = directory / "transcript.jsonl"
+        if record["turn"] != number or record["directory"] != f"turns/{number}" or record["exit_code"] != 0 or (directory / "exit-code").read_text().strip() != "0":
+            raise ValueError("failed or unordered turn evidence")
+        problem = transcript_problem(transcript)
+        if problem:
+            raise ValueError(problem)
+        session = session_id(transcript, session)
+        if record["session_id"] != session:
+            raise ValueError("turn session metadata does not match transcript")
+        combined += transcript.read_bytes()
+    if combined != (attempt / "transcript.jsonl").read_bytes():
+        raise ValueError("combined transcript does not match ordered turns")
+
+
+def run(model, workdir, output, seconds, prompts):
+    transcript = Path(output)
+    attempt = transcript.parent
+    records = []
+    session = None
+    deadline = time.monotonic() + int(seconds)
+    with transcript.open("wb") as combined, Path(output + ".err").open("wb") as errors:
+        for number, prompt in enumerate(prompts, 1):
+            directory = attempt / "turns" / str(number)
+            directory.mkdir(parents=True)
+            turn_transcript = directory / "transcript.jsonl"
+            command = ["opencode", "run", "--model", model, "--format", "json", "--dir", workdir]
+            if session is not None:
+                command += ["--session", session]
+            command += ["--", prompt]
+            started = time.monotonic()
+            code = 0
+            problem = ""
+            with turn_transcript.open("wb") as stdout, (directory / "transcript.jsonl.err").open("wb") as stderr:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    code = 124
+                else:
+                    child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr,
+                                             start_new_session=True)
+                    try:
+                        code = child.wait(timeout=remaining)
+                    except subprocess.TimeoutExpired:
+                        os.killpg(child.pid, signal.SIGTERM)
+                        try:
+                            child.wait(timeout=1)
+                        except subprocess.TimeoutExpired:
+                            pass
+                        # A tool may outlive the CLI, including after its leader exits.
+                        try:
+                            os.killpg(child.pid, signal.SIGKILL)
+                        except ProcessLookupError:
+                            pass
+                        child.wait()
+                        code = 124
+                    except BaseException:
+                        try:
+                            os.killpg(child.pid, signal.SIGKILL)
+                        except ProcessLookupError:
+                            pass
+                        child.wait()
+                        raise
+            if code == 0:
+                try:
+                    problem = transcript_problem(turn_transcript)
+                    if problem:
+                        raise ValueError(problem)
+                    session = session_id(turn_transcript, session)
+                except (ValueError, TypeError, KeyError) as error:
+                    code, problem = 13, str(error)
+            code = code if code >= 0 else 128 - code
+            (directory / "exit-code").write_text(f"{code}\n")
+            combined.write(turn_transcript.read_bytes())
+            combined.flush()
+            errors.write((directory / "transcript.jsonl.err").read_bytes())
+            if problem:
+                errors.write((problem + "\n").encode())
+            records.append({"turn": number, "directory": f"turns/{number}", "session_id": session,
+                            "exit_code": code, "error": problem or None,
+                            "elapsed_ms": round((time.monotonic() - started) * 1000)})
+            (attempt / "turns.json").write_text(json.dumps(records, indent=2) + "\n")
+            if code:
+                return code
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        prompts = json.load(sys.stdin)
+        if not isinstance(prompts, list) or not prompts or any(not isinstance(p, str) or not p.strip() for p in prompts):
+            raise ValueError("expected nonempty turns")
+        if sys.argv[1] == "validate":
+            validate(Path(sys.argv[2]), prompts)
+        elif sys.argv[1] == "run":
+            signal.signal(signal.SIGTERM, interrupted)
+            signal.signal(signal.SIGINT, interrupted)
+            sys.exit(run(*sys.argv[2:], prompts))
+        else:
+            raise ValueError("unknown native turns operation")
+    except (OSError, ValueError, TypeError, KeyError, subprocess.SubprocessError) as error:
+        print(f"native turns: {error}", file=sys.stderr)
+        sys.exit(13)
