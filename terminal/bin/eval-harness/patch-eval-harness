#!/usr/bin/env bash
set -euo pipefail

script=${BASH_SOURCE[0]}
while [[ -L "$script" ]]; do
  directory=$(dirname "$script")
  script=$(readlink "$script")
  [[ "$script" == /* ]] || script="$directory/$script"
done
root=$(CDPATH='' cd "$(dirname "$script")" && pwd)
package="${1:-$root/node_modules/@nano-step/eval-harness}"
patches=("$root/patches/eval-harness-0.4.2.patch" "$root/patches/eval-harness-gaps.patch" "$root/patches/eval-harness-workflows.patch")

# An enclosing checkout makes git apply skip these package-relative paths.
GIT_CEILING_DIRECTORIES=$(CDPATH='' cd "$package/.." && pwd -P)
export GIT_CEILING_DIRECTORIES

if [[ "$(node -p 'require(process.argv[1]).version' "$package/package.json")" != 0.4.2 ]]; then
  printf 'The eval-harness patch requires version 0.4.2.\n' >&2
  exit 1
fi
scratch=$(mktemp -d)
trap 'rm -rf -- "$scratch"' EXIT
cp -R "$package/." "$scratch/"
GIT_CEILING_DIRECTORIES="$GIT_CEILING_DIRECTORIES:$(dirname "$scratch")"

# Check the full chain on a copy before changing the installed package.
first=0
for ((last=${#patches[@]}-1; last>=0; last--)); do
  if git -C "$scratch" apply --reverse --check "${patches[$last]}" 2>/dev/null; then
    first=$((last+1))
    for ((index=last; index>=0; index--)); do
      git -C "$scratch" apply --reverse "${patches[$index]}"
    done
    break
  fi
done
for patch in "${patches[@]}"; do
  git -C "$scratch" apply --check "$patch"
  git -C "$scratch" apply "$patch"
done
for patch in "${patches[@]:$first}"; do
  git -C "$package" apply "$patch"
done
