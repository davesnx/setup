#!/usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Git log filtering
#?? 1.0.0
##?
##? Usage:
##?    git-log-pretty

docs::parse "$@"

commit=$(git log --graph --color=always --date=human --format="%C(auto)%h%d %s %C(black)%C(bold)%ad by %an" | fzf --ansi --no-sort)
commit_hash=$(printf '%s\n' "$commit" | awk '{print $2}')

printf '%s' "$commit_hash" | pbcopy
