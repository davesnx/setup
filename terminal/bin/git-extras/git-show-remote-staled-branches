#! /usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Show all remote staled branches
#?? 1.0.0
##?
##? Usage:
##?    git-show-remote-staled-branches

docs::parse "$@"

git branch -r --merged --format='%(refname:short)' |
  while IFS= read -r branch; do
    case "$branch" in origin/HEAD|origin/master) continue ;; esac
    printf '%s\t%s\n' "$(git show -s --format='%ci %cr %an' "$branch")" "$branch"
  done | sort -r
