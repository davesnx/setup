#! /usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Prints repository past effort
##? From https://github.com/tj/git-extras/blob/master/bin/git-effort
#?? 1.0.0
##?
##? Usage:
##?    git-effort [--above <value>] [<path>...]

docs::parse "$@"

tputq() {
  tput "$@" 2>/dev/null || true
}

cleanup() {
  if "$to_tty"; then
    tputq cnorm
    tputq sgr0
  fi
  rm -f -- "$tmp"
}

color_for() {
  "$to_tty" || return 0
  if (($1 > 200)); then
    tputq setaf 1
    tputq bold
  elif (($1 > 150)); then
    tputq setaf 1
  elif (($1 > 125)); then
    tputq setaf 2
    tputq bold
  elif (($1 > 100)); then
    tputq setaf 2
  elif (($1 > 75)); then
    tputq setaf 5
    tputq bold
  elif (($1 > 50)); then
    tputq setaf 5
  elif (($1 > 25)); then
    tputq setaf 3
    tputq bold
  elif (($1 > 10)); then
    tputq setaf 3
  else
    tputq sgr0
  fi
}

effort() {
  local path=$1 commit_dates commits active padding dots
  commit_dates=$(git log ${log_args[@]+"${log_args[@]}"} --format=%ad --date=short -- "$path") || return 255
  [[ -n "$commit_dates" ]] || return 0
  commits=$(printf '%s\n' "$commit_dates" | wc -l)
  ((commits > above)) || return 0
  active=$(printf '%s\n' "$commit_dates" | sort -u | wc -l)
  padding=$((columns - ${#path}))
  if ((padding < 0)); then padding=0; fi
  dots=$(printf '%*s' "$padding" '' | tr ' ' .)
  printf '  %s%s%s %-10d %s %d%s\n' \
    "$(color_for "$((commits - above))")" "$path" "$dots" "$commits" \
    "$(color_for "$((active - above))")" "$active" "$reset_color"
}

heading() {
  printf '\n  %-*s %-10s %s\n\n' "$columns" path commits 'active days'
}

# Background functions retain arrays and pass filenames without shell evaluation.
collect_effort() {
  local path pid count=0
  local pids=()
  for path in "$@"; do
    effort "$path" &
    pids+=("$!")
    count=$((count + 1))
    if ((count == 4)); then
      for pid in "${pids[@]}"; do wait "$pid"; done
      pids=()
      count=0
    fi
  done
  for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid"; done
}

above=0
paths=()
log_args=()
while (($#)); do
  case "$1" in
    --above)
      above=${2:-}
      if [[ ! "$above" =~ ^[0-9]+$ ]]; then
        echo 'error: --above requires an integer' >&2
        exit 1
      fi
      shift
      ;;
    --)
      shift
      log_args=("$@")
      break
      ;;
    --*)
      printf 'error: unknown argument %s; put git-log options after --\n' "$1" >&2
      exit 1
      ;;
    *) paths+=("$1") ;;
  esac
  shift
done

to_tty=false
reset_color=
if [[ -t 1 ]]; then
  to_tty=true
  reset_color=$(tputq sgr0)
fi
tmp=$(mktemp -t "$(basename "$0").XXXXXXX")
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

git ls-files -z >"$tmp"
columns=0
while IFS= read -r -d '' path; do
  if ((${#path} > columns)); then columns=${#path}; fi
done <"$tmp"
columns=$((columns + 5))

if ((${#paths[@]} == 0)); then
  while IFS= read -r -d '' path; do paths+=("$path"); done <"$tmp"
fi

if "$to_tty"; then tputq civis; fi

heading
collect_effort ${paths[@]+"${paths[@]}"} | tee "$tmp"
if (($(wc -l <"$tmp") > 1)); then
  if "$to_tty"; then clear; fi
  heading
  sort -rn -k 2 <"$tmp"
fi
echo
