#! /usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Count regular files recursively in each non-hidden subdirectory.
#?? 1.0.0
##?
##? Usage:
##?    count_files_recursive_per_directory

docs::parse "$@"

for directory in ./*/; do
  [[ -d "$directory" ]] || continue
  count=$(cd "$directory" && "$BASH" "$DOTFILES_PATH/terminal/bin/fs/count_files_recursive")
  printf '%s %d\n' "${directory#./}" "$count"
done
