#! /usr/bin/env bash

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Count files recursives in the current direcory disgregated per subdirectory
#?? 1.0.0
##?
##? Usage:
##?    count_files_recursive_per_directory

docs::parse "$@"

for directory in ./*/; do
  [[ -d "$directory" ]] || continue
  count=$(find "$directory" -type f -print0 | tr -cd '\0' | wc -c)
  printf '%s %d\n' "${directory#./}" "$count"
done
