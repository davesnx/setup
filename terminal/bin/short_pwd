#! /usr/bin/env zsh

set -euo pipefail

source "$DOTFILES_PATH/terminal/core/main.sh"

##? Short the current $PWD
#?? 1.0.0
##?
##? Usage:
##?    short_pwd

docs::parse "$@"

if [[ $PWD == $HOME || ${PWD:h} == $HOME || ${PWD:h} == / ]] ; then
  echo ${(D)PWD}
else
  echo ${${${:-/${(j:/:)${(M)${(s:/:)${(D)PWD:h:h}}#(|.)[^.]}}/${PWD:h:t}/${PWD:t}}//\/~/\~}/\/\//\/}
fi
