{
  "update.mode": "default",
  /* Window */
  "window.zoomLevel": 1.8,
  "window.title": "${dirty} ${rootName}${separator}${separator}${activeEditorShort}",
  "window.commandCenter": true,
  "window.newWindowDimensions": "inherit",
  "window.autoDetectColorScheme": false,
  "workbench.tips.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.showTabs": "multiple",
  "workbench.layoutControl.enabled": true,
  "workbench.tree.indent": 12,
  "workbench.sideBar.location": "left",
  /* Controls whether the tree should render indent guides. */
  "workbench.tree.renderIndentGuides": "always",
  /* Controls whether the panel opens maximized. It can either always open maximized,
  never open maximized, or open to the last state it was in before being closed. */
  "workbench.panel.opensMaximized": "never",
  /* Determines which settings editor to use by default. */
  "workbench.settings.editor": "json",
  "workbench.list.smoothScrolling": true,
  /* Controls which editor is shown at startup */
  "workbench.startupEditor": "none",
  "workbench.fontAliasing": "antialiased",
  "workbench.colorTheme": "Fosk",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "fluent-icons",
  "material-icon-theme.folders.theme": "specific",
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.statusBar.visible": true,
  "workbench.colorCustomizations": {},
  "workbench.navigationControl.enabled": false,
  /* Explorer */
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 1,
  "explorer.compactFolders": false,
  "explorer.decorations.colors": true,
  "explorer.decorations.badges": true,
  "explorer.autoReveal": true,
  /* Files */
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.esy": true,
    "**/.git": false,
    "**/.workplace": true
  },
  "files.watcherExclude": {
    "**/.esy": false,
    "**/_opam": false,
    "**/.DS_Store": true,
    "node_modules": false,
    "**/Thumbs.db": true,
    "**/.git": false,
    "**/.workplace/**": true
  },
  "files.associations": {
    ".env*": "dotenv",
    "*.ts": "typescriptreact",
    "*.js": "javascriptreact"
  },
  /* Search */
  "search.mode": "reuseEditor",
  "search.useReplacePreview": true,
  "search.showLineNumbers": true,
  "search.smartCase": true,
  "search.exclude": {
    "**/.git": true,
    "**/.vscode": true,
    "**/_esy": true,
    "**/esy.lock": true,
    "**/_opam*": true,
    "**/node_modules*": true,
    "**/_build": true,
    "**/build": true,
    "**/dist": true,
    "**/.next": true,
    "**/.workplace/**": true
  },
  /* Breadcrumbs */
  "breadcrumbs.enabled": true,
  "breadcrumbs.filePath": "on",
  "breadcrumbs.icons": false,
  /* Keyboard */
  "keyboard.dispatch": "keyCode",
  /* Editor */
  "editor.fontFamily": "JetBrains Mono, Ligalex Mono, IBM Plex Mono, Martian Mono, Monaco",
  "editor.codeLensFontSize": 16,
  "editor.codeLensFontFamily": "JetBrains Mono, Ligalex Mono, IBM Plex Mono, Martian Mono, Monaco",
  "editor.fontLigatures": false,
  "editor.rulers": [
    120
  ],
  "editor.tabSize": 2,
  "editor.fontSize": 15,
  "editor.fontWeight": "normal",
  "editor.wordWrap": "bounded",
  "editor.folding": true,
  "editor.glyphMargin": false,
  "editor.renderWhitespace": "boundary",
  "editor.wrappingIndent": "indent",
  "editor.cursorStyle": "block",
  "editor.columnSelection": false,
  "editor.formatOnSave": false,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.formatOnSaveMode": "file",
  "editor.inlineSuggest.enabled": true,
  "editor.renderLineHighlight": "none",
  "editor.lightbulb.enabled": "off",
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.occurrencesHighlight": "singleFile",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[]{}\\\\|;:'\\\",.<>/?",
  "editor.lineHeight": 2,
  "editor.bracketPairColorization.enabled": true,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.renderControlCharacters": true,
  "editor.useTabStops": false,
  "editor.detectIndentation": true,
  "editor.insertSpaces": true,
  "editor.snippetSuggestions": "bottom",
  "editor.cursorBlinking": "phase",
  "editor.hover.enabled": true,
  "editor.hover.above": true,
  "editor.hover.sticky": true,
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.tabCompletion": "on",
  "editor.stickyScroll.enabled": false,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.enabled": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.scrollPredominantAxis": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.accessibilitySupport": "off",
  "editor.unicodeHighlight.allowedCharacters": {
    "’": true,
    "‹": true,
    "›": true,
    "–": true
  },
  "editor.suggestFontSize": 16,
  "editor.suggest.insertMode": "insert",
  "editor.autoIndent": "none",
  "editor.colorDecorators": false,
  "editor.linkedEditing": true,
  "editor.suggest.showIcons": true,
  "editor.lineNumbers": "on",
  /* scm */
  "scm.diffDecorationsGutterVisibility": "always",
  "scm.alwaysShowActions": true,
  "scm.diffDecorations": "all",
  /* Terminal */
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.tabs.location": "left",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.fontWeight": "normal",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.external.osxExec": "iTerm.app",
  "terminal.integrated.inheritEnv": true,
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeightBold": "normal",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.allowMnemonics": true,
  "terminal.integrated.drawBoldTextInBrightColors": true,
  "terminal.explorerKind": "external",
  "terminal.integrated.env.osx": {},
  "security.workspace.trust.untrustedFiles": "open",
  /* Language specific */
  /* HTML */
  "html.format.enable": true,
  "html.format.preserveNewLines": true,
  "html.format.indentInnerHtml": true,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  /* Makefile */
  "makefile.configureOnOpen": true,
  /* JSON */
  "[json][jsonc]": {
    "editor.autoIndent": "full",
    "editor.formatOnPaste": false,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.formatOnSave": true,
    "editor.suggest.insertMode": "replace"
  },
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  /* TypeScript */
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.referencesCodeLens.enabled": false,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.inlayHints.parameterTypes.enabled": true,
  "[typescript][typescriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.typescript-language-features",
    "editor.codeActionsOnSave": {
      "source.fixAll.ts": "always"
    }
  },
  /* JavaScript */
  "js/ts.implicitProjectConfig.strictNullChecks": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "biome.suggestInstallingGlobally": false,
  "[javascript][javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.fixAll.ts": "always"
    }
  },
  /* OCaml */
  "ocaml.dune.autoDetect": true,
  "ocaml.server.codelens.enable": true,
  "ocaml.server.duneDiagnostics": true,
  "ocaml.server.extendedHover": true,
  "ocaml.server.extraEnv": {
    "OCAMLLSP_SEMANTIC_HIGHLIGHTING": "full"
  },
  "[ocaml.opam][ocaml.menhir][ocaml.mlx][dune]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ocamllabs.ocaml-platform"
  },
  "[ocaml][ocaml.interface]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ocamllabs.ocaml-platform"
  },
  "material-icon-theme.files.associations": {
    "*.mlx": "ocaml",
    "*.mll": "ocaml"
  },
  /* ReScript */
  "[rescript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "chenglou92.rescript-vscode",
    "rescript.settings.askToStartBuild": false
  },
  /* Reason */
  "[reason][reason.interface]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ocamllabs.ocaml-platform"
  },
  "[cram]": {
    "editor.tabSize": 2,
    "files.trimTrailingWhitespace": false
  },
  /* Extensions */
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "extensions.ignoreRecommendations": true,
  /* Error Lens */
  "errorLens.enabled": true,
  "errorLens.padding": "0",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.removeLinebreaks": false,
  "errorLens.fontWeight": "600",
  "errorLens.scrollbarHackEnabled": true,
  /* GitLens */
  "git.decorations.enabled": true,
  "gitlens.codeLens.scopes": [],
  "gitlens.hovers.avatars": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.statusBar.enabled": true,
  "gitlens.currentLine.format": "${message|50?} ${'in 'pullRequest}• ${agoOrDate} by ${author}",
  "gitlens.currentLine.uncommittedChangesFormat": "${message|50?} ${'in 'pullRequest}• ${agoOrDate}",
  "gitlens.advanced.messages": {
    "suppressLineUncommittedWarning": true
  },
  "gitlens.hovers.currentLine.over": "line",
  /* Emmet */
  "emmet.showSuggestionsAsSnippets": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  /* Remote */
  "remote.SSH.remotePlatform": {
    "nspawn": "linux"
  },
  "remote.SSH.useLocalServer": false,
  "remote.SSH.remoteServerListenOnSocket": true,
  "remote.SSH.configFile": "/Users/davesnx/.ssh/config",
  "remote.autoForwardPortsSource": "hybrid",
  /* Apc Customize UI++ */
  "window.titleBarStyle": "custom",
  "apc.electron": {
    "titleBarStyle": "hiddenInset",
    "trafficLightPosition": {
      "x": 16,
      "y": 10
    }
  },
  "apc.font.family": "JetBrains Mono",
  "apc.header": {
    "height": 40,
    "fontSize": 15
  },
  "apc.listRow": {
    "height": 23,
    "fontSize": 13
  },
  "apc.stylesheet": {},
  /* Where am I */
  "where-am-i.textTransfrom": "none",
  /* Go to next error */
  "go-to-next-error.multiSeverityHandlingMethod": "hover",
  /* Cursor */
  "cursor.composer.usageSummaryDisplay": "always"
}
