<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.davesnx.ssh-add</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/ssh-add --apple-load-keychain; exec /usr/bin/ssh-add "$HOME/.ssh/id_rsa"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
