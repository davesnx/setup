# MacOS
.DS_Store
._*

# Zsh generated bytecode
*.zwc

# Python bytecode
__pycache__/

# Skills downloaded by Claude Desktop
/agents/skills/synced/

# Private Stuff
/**/**/private-*

# Choosy license (settings only belong in Git)
/mac/choosy/**/.key

# OpenCode private and generated state
/terminal/opencode/service.json
/terminal/opencode/user_profile.json
/terminal/opencode/technical_memory.md
/terminal/opencode/memory.instruction.md
/terminal/opencode/tasks/
/terminal/opencode/node_modules
/terminal/opencode/*.lock
/terminal/opencode/package-lock.json
/terminal/opencode/host.jsonc
/terminal/opencode/.opencode/
# The @plannotator/opencode plugin writes these empty command stubs on install
# and handles the commands itself, so they are not hand-authored content.
/terminal/opencode/commands/plannotator-*.md

# Eval harness dependencies
/terminal/bin/eval-harness/node_modules

# Shared Node CLI dependencies (normally installed outside the repo)
/terminal/node/node_modules

# Machine-specific overrides
/local/*
!/local/README.md
!/local/main.sh
!/local/install.sh

# Claude Code machine-local settings (the global ignore only matches .claude/ paths)
/terminal/claude/settings.local.json
/terminal/claude/hooks/node_modules
