{
  "servers": {
    "notion": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.notion.com/mcp"
    },
    "ahrefs": {
      "type": "remote",
      "enabled": true,
      "url": "https://api.ahrefs.com/mcp/mcp"
    },
    "linear": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.linear.app/mcp"
    },
    "strava": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@r-huijts/strava-mcp-server"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@1.8.0",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--redact-network-headers"
      ]
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "hosts": {
    "ssh": {
      "notion": {
        "oauth": {
          "callbackPort": 25121
        }
      },
      "ahrefs": {
        "oauth": {
          "callbackPort": 25122
        }
      },
      "linear": {
        "oauth": {
          "callbackPort": 25123
        }
      },
      "grafana": {
        "type": "local",
        "enabled": true,
        "command": [
          "grafana-mcp"
        ]
      },
      "buildkite": {
        "type": "local",
        "enabled": false,
        "command": [
          "buildkite-mcp-server",
          "stdio"
        ],
        "environment": {
          "BUILDKITE_API_TOKEN": "{env:BUILDKITE_API_TOKEN}",
          "BUILDKITE_ORG_SLUG": "ahrefs"
        }
      }
    }
  }
}
